{
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "async": true,
            "command": "afplay /System/Library/Sounds/Glass.aiff",
            "type": "command"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "auto",
        "hooks": [
          {
            "type": "command",
            "command": "echo '⚠️ 上下文即将达到 20 万 tokens 上限，建议 /transfer-context 或 /handoff 交接后继续。'",
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/karpathy-check.sh",
            "once": true,
            "async": true
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/plan-guard.sh",
            "once": false,
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/plan-trigger.sh",
            "once": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'DIR=\"$PWD\"; while [ \"$DIR\" != \"/\" ]; do if [ -d \"$DIR/.git\" ] \u0026\u0026 [ -d \"$DIR/.claude/haness\" ]; then rm -f \"$DIR/.claude/haness/session-artifacts.log\"; break; fi; DIR=$(dirname \"$DIR\"); done'",
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/track-artifacts.sh",
            "async": true
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/log-skill-call.sh",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/plan-stop-verify.sh"
          }
        ]
      }
    ]
  },
  "effortLevel": "high",
  "spinnerTipsEnabled": false,
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "kimi-k2.6",
    "ANTHROPIC_BASE_URL": "https://api.kimi.com/coding/",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "kimi-k2.6",
    "ANTHROPIC_AUTH_TOKEN": "sk-kimi-TlwAKawT1VHrWj2uoIudrUXannt53ag3s5MXj1asWKPUEGH0j9v9EFeLjU80uKBE",
    "ANTHROPIC_MODEL": "kimi-k2.6",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "kimi-k2.6",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "kimi-k2.6",
    "API_TIMEOUT_MS": "600000",
    "ENABLE_TOOL_SEARCH": "false"
  },
  "skipDangerousModePermissionPrompt": true,
  "skipAutoPermissionPrompt": true,
  "autoCompactWindow": 235000,
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/hooks/context-usage.sh",
    "refreshInterval": 5
  }
}