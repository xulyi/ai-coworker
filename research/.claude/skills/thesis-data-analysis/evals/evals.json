  "cases": [
    {
      "id": "P0-A-independent-groups-continuous",
      "priority": "P0",
      "category": "差异比较-两独立组-连续变量",
      "prompt": "我有实验组和对照组各30人，测量了干预后的步行速度（m/s），想知道两组之间是否存在差异。数据在 /tmp/gait_data.csv，列名为 group（1=对照，2=实验）和 speed。请帮我分析。",
      "context": {
        "study_design": "两组平行对照",
        "n_groups": 2,
        "sample_type": "independent",
        "outcome_type": "continuous",
        "distribution": "unknown"
      },
      "expected_checks": {
        "must_pass": [
          "asks_clarifying_questions",
          "outputs_statistical_path",
          "validates_assumptions_normality",
          "validates_assumptions_levene",
          "selects_method_based_on_assumptions",
          "provides_effect_size_with_ci",
          "provides_paper_style_summary",
          "no_fabrication"
        ],
        "should_pass": [
          "provides_python_code",
          "provides_spss_syntax",
          "provides_three_line_table",
          "distinguishes_statistical_clinical_significance"
        ],
        "bonus": [
          "mentions_limitations",
          "offers_power_analysis",
          "apa7_p_value_format"
        ]
      },
      "instant_fail_if": [
        "runs_t_test_without_normality_check",
        "ignores_levene_result_when_choosing_t_variant",
        "no_effect_size_reported",
        "fabricates_results"
      ],
      "notes": "核心路径：澄清样本独立性 → Shapiro-Wilk → Levene → 选 t/Welch/Mann-Whitney → Cohen's d 或 r → 论文段落。重点检查 Levene 后是否正确选择等方差或 Welch 版本。"
    },
    {
      "id": "P0-B-wrong-method-correction",
      "priority": "P0",
      "category": "错误方法纠偏",
      "prompt": "我有两组数据，数据分布明显偏态（Q-Q图显示严重偏离正态线），帮我做独立样本t检验分析两组差异。",
      "context": {
        "study_design": "两组独立样本",
        "distribution": "skewed",
        "user_specified_method": "independent t-test",
        "method_appropriate": false
      },
      "expected_checks": {
        "must_pass": [
          "rejects_direct_execution",
          "explains_why_t_test_inappropriate",
          "provides_alternative_method",
          "alternative_is_mann_whitney_u",
          "no_fabrication"
        ],
        "should_pass": [
          "offers_to_run_both_with_warning",
          "explains_effect_size_for_nonparametric"
        ],
        "bonus": [
          "mentions_log_transformation_option",
          "explains_central_limit_theorem_exception"
        ]
      },
      "instant_fail_if": [
        "directly_runs_t_test_without_questioning",
        "no_mention_of_normality_violation",
        "no_alternative_method_provided"
      ],
      "notes": "关键测试：模型是否会在用户明确说数据偏态的情况下仍然直接执行t检验。正确行为是先解释前提不满足，再提供Mann-Whitney U方案，若用户坚持才执行并加风险警告。"
    },
    {
