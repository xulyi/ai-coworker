      "expected_checks": {
        "must_pass": [
          "identifies_paired_design",
          "validates_normality_of_differences",
          "selects_paired_t_or_wilcoxon",
          "uses_dz_not_ds_for_effect_size",
          "outputs_statistical_path",
          "provides_paper_style_summary",
          "no_fabrication"
        ],
        "should_pass": [
          "discusses_berg_as_continuous_with_caveat",
          "provides_paired_plot_suggestion",
          "provides_python_code",
          "provides_spss_syntax",
          "reports_pre_post_descriptives"
        ],
        "bonus": [
          "mentions_mcid_clinical_significance",
          "suggests_bland_altman_if_reliability_context"
        ]
      },
      "instant_fail_if": [
